{
  "expo": {
    "name": "CoachLift",
    "slug": "coachlift",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#faf7f0"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.coachlift.app",
      "buildNumber": "15",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "CoachLift uses your camera to identify gym equipment.",
        "NSPhotoLibraryUsageDescription": "CoachLift accesses your photo library to identify gym equipment.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.coachlift.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      [
        "expo-image-picker",
        {
          "photosPermission": "CoachLift accesses your photos to identify gym equipment."
        }
      ],
      "expo-font"
    ],
    "scheme": "coachlift",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "31aab18c-fd83-42a8-b2de-cc29cc5f7055"
      }
    },
    "owner": "affilm426"
  }
}
