{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "rootDir": "..",
    "outDir": "../dist-server"
  },
  "include": ["./**/*.ts", "../lib/ai.ts", "../lib/youtube.ts", "../lib/coachingEngine.ts"],
  "exclude": ["../node_modules"]
}
