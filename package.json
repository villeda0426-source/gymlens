{
  "name": "spotlift",
  "version": "1.0.7",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "npm run build:server",
    "build:server": "tsc -p server/tsconfig.json",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "smoke:api": "ts-node --project server/tsconfig.json scripts/release-smoke-test.ts",
    "smoke:api:local": "RELEASE_SMOKE_ALLOW_LOCAL=1 ts-node --project server/tsconfig.json scripts/release-smoke-test.ts",
    "check:release": "npm run typecheck && npm run typecheck:server && npm run smoke:api",
    "check:app-review": "ts-node scripts/app-review-preflight.ts",
    "start:server": "node dist-server/server/index.js",
    "server": "ts-node --project server/tsconfig.json server/index.ts",
    "server:dev": "nodemon --exec \"ts-node --project server/tsconfig.json server/index.ts\"",
    "setup": "ts-node --project server/tsconfig.json server/setup.ts",
    "seed": "ts-node --project server/tsconfig.json scripts/seed.ts"
  },
  "dependencies": {
    "@expo-google-fonts/barlow-condensed": "latest",
    "@expo-google-fonts/dm-sans": "latest",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo-google-fonts/space-mono": "latest",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.43.0",
    "@types/nodemailer": "^8.0.0",
    "axios": "^1.7.0",
    "babel-preset-expo": "~57.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "expo": "^57.0.0",
    "expo-apple-authentication": "~57.0.2",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.19",
    "expo-image-picker": "~57.0.19",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-sharing": "~57.0.21",
    "expo-speech-recognition": "^3.1.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "express": "^4.19.0",
    "i18next": "^23.0.0",
    "jsonrepair": "^3.15.0",
    "multer": "^1.4.5-lts.1",
    "nativewind": "^4.0.0",
    "nodemailer": "^9.0.1",
    "openai": "^6.49.0",
    "pg": "^8.20.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^14.0.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-shake": "^6.8.5",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.0",
    "vexo-analytics": "^1.5.7",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "~19.2.4",
    "babel-plugin-module-resolver": "^5.0.0",
    "jimp": "^1.6.1",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
