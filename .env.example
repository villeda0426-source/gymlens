# Anthropic
ANTHROPIC_API_KEY=your_key_here

# Supabase
SUPABASE_URL=your_project_url
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# YouTube
YOUTUBE_API_KEY=your_key_here

# App
# Local development:
# API_BASE_URL=http://localhost:3001
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3001
#
# Production/App Store builds must use your deployed API URL, never localhost.
API_BASE_URL=https://your-deployed-api.example.com
EXPO_PUBLIC_API_BASE_URL=https://your-deployed-api.example.com
EXPO_PUBLIC_SUPABASE_URL=your_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_SENTRY_DSN=https://public_key@o000000.ingest.sentry.io/000000

# Sentry source-map upload for EAS builds
# Store this as an EAS secret, not in .env:
# eas secret:create --scope project --name SENTRY_AUTH_TOKEN --value your_sentry_auth_token
SENTRY_ORG=your_sentry_org_slug
SENTRY_PROJECT=your_sentry_project_slug

# Force update controls
# Keep these inactive until the new binary is live in the App Store/Play Store.
MIN_IOS_BUILD_NUMBER=0
LATEST_IOS_BUILD_NUMBER=35
IOS_STORE_URL=https://apps.apple.com/us/app/coachlift/id6768139635
MIN_ANDROID_VERSION_CODE=0
LATEST_ANDROID_VERSION_CODE=2
ANDROID_STORE_URL=market://details?id=com.coachlift.app
ANDROID_WEB_STORE_URL=https://play.google.com/store/apps/details?id=com.coachlift.app
FORCE_UPDATE_REJECT_LEGACY_CLIENTS=false
